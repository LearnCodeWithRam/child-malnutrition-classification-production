# ==============================================================================
# POSHAN AI PRODUCTION STACK - HOSTINGER VPS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Host / Domain Configuration
PUBLIC_APP_URL=https://your-domain-or-vps-ip.com

# PostgreSQL Database Configuration
POSTGRES_DB=poshan_db
POSTGRES_USER=poshan_user
POSTGRES_PASSWORD=your_strong_postgres_password_2026
DATABASE_URL=postgresql://poshan_user:your_strong_postgres_password_2026@postgres:5432/poshan_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis & Celery Message Broker Configuration
REDIS_PASSWORD=your_strong_redis_password_2026
CELERY_BROKER_URL=redis://:your_strong_redis_password_2026@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your_strong_redis_password_2026@redis:6379/1

# NVMe Persistent Storage Path
RAW_PHOTOS_DIR=/app/data/raw_photos

# Administrative API Key for Bulk Exports & Data Deletion
ADMIN_API_KEY=your_secure_admin_api_key_2026

# Real-Time Monitoring Dashboards Configuration
DOZZLE_PORT=8888
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:your_secure_flower_password_2026

# Meta WhatsApp Cloud API Credentials
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_ACCESS_TOKEN=your_permanent_meta_access_token
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=poshan_secret_webhook_token_2026
META_FLOW_ID=your_registered_flow_id

# Meta Flow Private Key for Payload Decryption
META_FLOW_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

